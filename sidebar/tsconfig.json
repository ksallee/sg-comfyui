{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["svelte"],
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
